[
  {
    "name": "cat of a file over the ceiling is denied",
    "tool_name": "Bash",
    "tool_input": {"command": "cat huge.json"},
    "expect": "deny",
    "denyMatch": "straight into context"
  },
  {
    "name": "cat of a small file is allowed (no size, no rule)",
    "tool_name": "Bash",
    "tool_input": {"command": "cat foo.json"},
    "expect": "allow"
  },
  {
    "name": "cat of a mid-size file under the ceiling is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "cat big.ts"},
    "expect": "allow"
  },
  {
    "name": "cat of a huge file piped to a filter is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "cat huge.json | jq '.dependencies'"},
    "expect": "allow"
  },
  {
    "name": "cat of a huge file piped to head is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "cat huge.json | head -20"},
    "expect": "allow"
  },
  {
    "name": "cat of a huge file redirected to a file is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "cat huge.json > copy.json"},
    "expect": "allow"
  },
  {
    "name": "cat of a huge file appended to a file is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "cat huge.json >> copy.json"},
    "expect": "allow"
  },
  {
    "name": "cat with a stderr-only redirect still dumps to context and is denied",
    "tool_name": "Bash",
    "tool_input": {"command": "cat huge.json 2>/dev/null"},
    "expect": "deny",
    "denyMatch": "straight into context"
  },
  {
    "name": "sudo cat of a huge file is denied (wrapper is unwrapped)",
    "tool_name": "Bash",
    "tool_input": {"command": "sudo cat huge.json"},
    "expect": "deny"
  },
  {
    "name": "cat of a huge file after && is denied (later segments are checked)",
    "tool_name": "Bash",
    "tool_input": {"command": "npm test && cat huge.json"},
    "expect": "deny"
  },
  {
    "name": "cat merely named in another command's arguments is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "git commit -m 'stop using cat huge.json'"},
    "expect": "allow"
  },
  {
    "name": "cat of a nonexistent path is allowed (unstattable → fail open)",
    "tool_name": "Bash",
    "tool_input": {"command": "cat nope.json"},
    "expect": "allow"
  },
  {
    "name": "cat of a glob is allowed (shell expansion → unstattable)",
    "tool_name": "Bash",
    "tool_input": {"command": "cat *.json"},
    "expect": "allow"
  },
  {
    "name": "cat of a directory is allowed (not a regular file)",
    "tool_name": "Bash",
    "tool_input": {"command": "cat src"},
    "expect": "allow"
  },
  {
    "name": "cat writing a heredoc to a file is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "cat > out.txt <<EOF\nhello\nEOF"},
    "expect": "allow"
  },

  {
    "name": "head of a huge file is allowed (bounded by construction)",
    "tool_name": "Bash",
    "tool_input": {"command": "head -100 huge.json"},
    "expect": "allow"
  },
  {
    "name": "tail of a huge file is allowed (bounded by construction)",
    "tool_name": "Bash",
    "tool_input": {"command": "tail -50 huge.json"},
    "expect": "allow"
  },
  {
    "name": "sed -n range read of a huge file is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "sed -n '100,200p' huge.json"},
    "expect": "allow"
  },
  {
    "name": "sed -i edit of a huge file is allowed (auto mode edits with sed)",
    "tool_name": "Bash",
    "tool_input": {"command": "sed -i '' 's/foo/bar/g' huge.json"},
    "expect": "allow"
  },
  {
    "name": "awk over a huge file is allowed (output is program-derived)",
    "tool_name": "Bash",
    "tool_input": {"command": "awk -F, '{s+=$2} END{print s}' huge.json"},
    "expect": "allow"
  },
  {
    "name": "grep over a huge file is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "grep -n someSymbolName huge.json"},
    "expect": "allow"
  },
  {
    "name": "bare tree-wide grep for a symbol is allowed (rule removed)",
    "tool_name": "Bash",
    "tool_input": {"command": "grep -rn someSymbolName ."},
    "expect": "allow"
  },
  {
    "name": "find -exec cat is allowed (rule removed)",
    "tool_name": "Bash",
    "tool_input": {"command": "find . -name '*.ts' -exec cat {} \\;"},
    "expect": "allow"
  },
  {
    "name": "git show of a file is allowed (rule removed)",
    "tool_name": "Bash",
    "tool_input": {"command": "git show HEAD~3:big.ts"},
    "expect": "allow"
  },

  {
    "name": "git diff with two dots is denied (folds in main-only changes)",
    "tool_name": "Bash",
    "tool_input": {"command": "git diff main..feature"},
    "expect": "deny",
    "denyMatch": "three dots"
  },
  {
    "name": "git diff with three dots is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "git diff main...feature"},
    "expect": "allow"
  },
  {
    "name": "git diff with a space-separated pair is allowed (the escape hatch)",
    "tool_name": "Bash",
    "tool_input": {"command": "git diff main feature"},
    "expect": "allow"
  },
  {
    "name": "git diff with a relative pathspec is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "git diff -- ../src/foo.ts"},
    "expect": "allow"
  },
  {
    "name": "echo mentioning a two-dot git diff range is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "echo 'run git diff main..feature'"},
    "expect": "allow"
  },
  {
    "name": "a two-dot git diff inside a heredoc body is allowed",
    "tool_name": "Bash",
    "tool_input": {"command": "cat > run.sh <<'EOF'\ngit diff main..feature\nEOF"},
    "expect": "allow"
  },
  {
    "name": "git diff two-dot after a shell keyword is denied",
    "tool_name": "Bash",
    "tool_input": {"command": "if true; then git diff main..feature; fi"},
    "expect": "deny"
  },

  {
    "name": "Read of a file over the ceiling with no limit is denied",
    "tool_name": "Read",
    "tool_input": {"file_path": "huge.json"},
    "expect": "deny",
    "denyMatch": "too big to read whole"
  },
  {
    "name": "Read of a huge file with a limit is allowed",
    "tool_name": "Read",
    "tool_input": {"file_path": "huge.json", "limit": 200},
    "expect": "allow"
  },
  {
    "name": "Read of a huge file with an offset is allowed",
    "tool_name": "Read",
    "tool_input": {"file_path": "huge.json", "offset": 500},
    "expect": "allow"
  },
  {
    "name": "Read of a mid-size code file under the ceiling is allowed",
    "tool_name": "Read",
    "tool_input": {"file_path": "big.ts"},
    "expect": "allow"
  },
  {
    "name": "Read of a mid-size markdown file under the ceiling is allowed",
    "tool_name": "Read",
    "tool_input": {"file_path": "big.md"},
    "expect": "allow"
  },
  {
    "name": "Read of a huge markdown file is denied (no extension list any more)",
    "tool_name": "Read",
    "tool_input": {"file_path": "huge.md"},
    "expect": "deny",
    "denyMatch": "too big to read whole"
  },
  {
    "name": "Read of a nonexistent file is allowed (fail open)",
    "tool_name": "Read",
    "tool_input": {"file_path": "nope.ts"},
    "expect": "allow"
  },

  {
    "name": "WebFetch of a GitHub issue is denied (use gh)",
    "tool_name": "WebFetch",
    "tool_input": {"url": "https://github.com/mourner/leaflet/issues/1234"},
