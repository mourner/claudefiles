    "denyMatch": "gh issue view 1234"
  },
  {
    "name": "WebFetch of a GitHub PR is denied (use gh)",
    "tool_name": "WebFetch",
    "tool_input": {"url": "https://github.com/mourner/leaflet/pull/99"},
    "expect": "deny",
    "denyMatch": "gh pr view 99"
  },
  {
    "name": "WebFetch of a GitHub blob is denied (use raw)",
    "tool_name": "WebFetch",
    "tool_input": {"url": "https://github.com/mourner/leaflet/blob/main/src/Map.js"},
    "expect": "deny",
    "denyMatch": "raw.githubusercontent.com"
  },
  {
    "name": "WebFetch of a GitHub repo root is allowed",
    "tool_name": "WebFetch",
    "tool_input": {"url": "https://github.com/mourner/leaflet"},
    "expect": "allow"
  },
  {
    "name": "WebFetch of a non-GitHub URL is allowed",
    "tool_name": "WebFetch",
    "tool_input": {"url": "https://example.com/docs/api"},
    "expect": "allow"
  },

  {
    "name": "an unknown tool is allowed",
    "tool_name": "Grep",
    "tool_input": {"pattern": "foo"},
    "expect": "allow"
  },
  {
    "name": "LSP is no longer guarded (plugin dormant, rule removed)",
    "tool_name": "LSP",
    "tool_input": {"operation": "workspaceSymbol"},
    "expect": "allow"
  }
]
